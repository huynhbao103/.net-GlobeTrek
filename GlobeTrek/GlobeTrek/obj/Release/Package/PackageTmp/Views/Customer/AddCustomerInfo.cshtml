@{
    ViewBag.Title = "Thêm thông tin khách hàng";
    Layout = "~/Views/Shared/_headerLayout.cshtml";
}

<div class="container mt-5 p-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-header bg-success text-white text-center">
                    <h4 class="card-title mb-0">Thông tin khách hàng</h4>
                </div>
                <div class="card-body">
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success">
                            @TempData["SuccessMessage"]
                        </div>
                    }

                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger">
                            @TempData["ErrorMessage"]
                        </div>
                    }

                    <!-- Hiển thị bảng nếu đã có CustomerInfo -->
                    @if (ViewBag.CustomerInfo != null)
                    {
                        var customerInfo = (GlobeTrek.Models.CustomerInfo)ViewBag.CustomerInfo;
                        <h5 class="mb-3">Thông tin đã lưu:</h5>
                        <table class="table table-bordered table-hover">
                            <thead class="thead-light">
                                <tr>
                                    <th>Họ và tên</th>
                                    <th>Số điện thoại</th>
                                    <th>Email</th>
                                    <th>Hành động</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>@customerInfo.fullName</td>
                                    <td>@customerInfo.phone</td>
                                    <td>@customerInfo.email</td>
                                    <td>
                                        <a href="@Url.Action("EditCustomerInfo", "Customer", new { id = customerInfo.id })" class="btn btn-sm btn-warning">
                                            <i class="bi bi-pencil"></i> Sửa
                                        </a>
                                        @using (Html.BeginForm("DeleteCustomerInfo", "Customer", new { id = customerInfo.id }, FormMethod.Post, new { @style = "display:inline;" }))
                                        {
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Bạn có chắc muốn xóa thông tin này không?');">
                                                <i class="bi bi-trash"></i> Xóa
                                            </button>
                                        }
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <!-- Form thêm thông tin nếu chưa có CustomerInfo -->
                        using (Html.BeginForm("AddCustomerInfo", "Customer", FormMethod.Post, new { @class = "needs-validation", novalidate = "novalidate" }))
                        {
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="userId" value="@Session["UserID"]" />

                            <div class="mb-3">
                                <label for="fullName" class="form-label">Họ và tên</label>
                                <input type="text" name="fullName" id="fullName" class="form-control" placeholder="Nhập họ và tên" required="required" />
                                <div class="invalid-feedback">
                                    Vui lòng nhập họ và tên.
                                </div>
                            </div>

                            <div class="mb-3">
                                <label for="phone" class="form-label">Số điện thoại</label>
                                <input type="text" name="phone" id="phone" class="form-control" placeholder="Nhập số điện thoại" required="required" />
                                <div class="invalid-feedback">
                                    Vui lòng nhập số điện thoại.
                                </div>
                            </div>

                            <div class="mb-3">
                                <label for="email" class="form-label">Email</label>
                                <input type="text" name="email" id="email" class="form-control" value="@ViewBag.UserEmail" readonly="readonly" placeholder="Email" />
                            </div>

                            <div class="d-grid gap-2">
                                <button type="submit" class="btn btn-success btn-lg">
                                    <i class="bi bi-plus-circle me-2"></i> Thêm thông tin
                                </button>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Bootstrap JS và dependencies -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
    (function () {
        'use strict'
        var forms = document.querySelectorAll('.needs-validation')
        Array.prototype.slice.call(forms)
            .forEach(function (form) {
                form.addEventListener('submit', function (event) {
                    if (!form.checkValidity()) {
                        event.preventDefault()
                        event.stopPropagation()
                    }
                    form.classList.add('was-validated')
                }, false)
            })
    })();
</script>